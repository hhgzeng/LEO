# ==============================================================================
# LEO (Large Language Model-Based Evolutionary Optimizer) Environment Config
# ==============================================================================

# 1. LLM API & Endpoint
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LEO_MODEL_NAME=gpt-3.5-turbo-0613

# 2. Execution Mode (true = offline mock, false = live API)
LEO_MOCK_LLM=true

# 3. Caching & Retries
LEO_CACHE_DIR=.leo_cache
MAX_RETRIES=5
INITIAL_RETRY_DELAY=1.0

# 4. Optimization Defaults
LEO_DEFAULT_POP_SIZE=10
LEO_DEFAULT_MAX_ITERS=30
LEO_DEFAULT_JITTER_SCALE=0.0001
LEO_DEFAULT_SOL_TO_PORT=1
